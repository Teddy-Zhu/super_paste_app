#include <winver.h>

1 ICON "@ICON@"

1 VERSIONINFO
FILEVERSION @VERSION_NUMBER@
PRODUCTVERSION @VERSION_NUMBER@
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Teddy Zhu\0"
      VALUE "FileDescription", "Super Paste\0"
      VALUE "FileVersion", "@VERSION_STRING@\0"
      VALUE "InternalName", "super-paste\0"
      VALUE "OriginalFilename", "super-paste.exe\0"
      VALUE "ProductName", "Super Paste\0"
      VALUE "ProductVersion", "@VERSION_STRING@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
