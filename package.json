{
  "name": "super_paste_app",
  "version": "1.0.0",
  "description": "An advanced clipboard manager tool",
  "main": "./out/main/index.js",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "pnpm run build:native --if-missing && electron-vite dev --sourcemap --remote-debugging-port=9222",
    "build:native": "pnpm --filter @super-paste/active-window-kwin build",
    "build": "pnpm run build:native --if-missing && pnpm run typecheck && electron-vite build",
    "postinstall": "node -e \"require('electron')\" && electron-builder install-app-deps",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "build:win": "pnpm run build && electron-builder --win",
    "build:mac": "pnpm run build && electron-builder --mac",
    "build:linux": "pnpm run build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@paymoapp/active-window": "^2.1.2",
    "@super-paste/active-window-kwin": "workspace:*",
    "@teddyzhu/auto-launch": "6.0.0-rc.8",
    "@teddyzhu/clipboard": "0.0.10",
    "@zxing/library": "^0.21.3",
    "better-sqlite3": "^12.11.1",
    "canvas": "^3.2.3",
    "electron-log": "^5.4.1",
    "electron-store": "^10.1.0",
    "jimp": "^1.6.0",
    "onnxruntime-common": "^1.22.0",
    "onnxruntime-node": "1.22.0-rev",
    "qrcode": "^1.5.4",
    "qrcode-reader": "^1.0.4",
    "webdav": "^5.8.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/rebuild": "^4.2.1",
    "@iconify-json/mdi": "^1.2.3",
    "@types/node": "^24.9.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vueuse/core": "^13.4.0",
    "dompurify": "^3.2.6",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.36.0",
    "eslint-plugin-vue": "^10.4.0",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.4.1",
    "prettier": "^3.6.2",
    "rtf-to-html-converter": "^1.2.4",
    "smooth-scrollbar": "^8.8.4",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "^19.3.0",
    "unplugin-icons": "^22.1.0",
    "unplugin-vue-components": "^28.8.0",
    "unplugin-vue-router": "^0.14.0",
    "vite": "^7.3.7",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-plugin-vue-meta-layouts": "^0.5.1",
    "vue": "^3.5.21",
    "vue-eslint-parser": "^10.2.0",
    "vue-router": "^4.5.1",
    "vue-tsc": "^3.3.13"
  },
  "packageManager": "pnpm@11.4.0+sha512.f0febc7e37552ab485494a914241b338e0b3580b93d54ce31f00933015880863129038a1b4ae4e414a0ee63ac35bf21197e990172c4a68256450b5636310968f",
  "desktopName": "com.v2dawn.sp.desktop"
}
