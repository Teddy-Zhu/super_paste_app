{
  "name": "super_paste_app",
  "version": "1.0.0",
  "description": "An advanced clipboard manager tool",
  "main": "./out/main/index.js",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev --sourcemap --remote-debugging-port=9222",
    "build": "pnpm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "build:win": "pnpm run build && electron-builder --win",
    "build:mac": "pnpm run build && electron-builder --mac",
    "build:linux": "pnpm run build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@paymoapp/active-window": "^2.1.2",
    "@teddyzhu/auto-launch": "6.0.0-rc.8",
    "@teddyzhu/clipboard": "^0.0.5",
    "@zxing/library": "^0.21.3",
    "better-sqlite3": "^12.2.0",
    "canvas": "^3.1.2",
    "electron-log": "^5.4.1",
    "electron-store": "^10.1.0",
    "jimp": "^1.6.0",
    "node-abi": "^3.78.0",
    "onnxruntime-common": "^1.22.0",
    "onnxruntime-node": "1.22.0-rev",
    "qrcode": "^1.5.4",
    "qrcode-reader": "^1.0.4",
    "sharp": "^0.34.5",
    "webdav": "^5.8.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/rebuild": "^4.0.1",
    "@iconify-json/mdi": "^1.2.3",
    "@types/node": "^24.9.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vueuse/core": "^13.4.0",
    "dompurify": "^3.2.6",
    "electron": "^38.1.2",
    "electron-builder": "^25.1.8",
    "electron-vite": "^4.0.1",
    "eslint": "^9.36.0",
    "eslint-plugin-vue": "^10.4.0",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.4.1",
    "prettier": "^3.6.2",
    "rtf-to-html-converter": "^1.2.4",
    "smooth-scrollbar": "^8.8.4",
    "typescript": "^5.0.2",
    "unplugin-auto-import": "^19.3.0",
    "unplugin-icons": "^22.1.0",
    "unplugin-vue-components": "^28.8.0",
    "unplugin-vue-router": "^0.14.0",
    "vite": "^7.1.6",
    "vite-plugin-commonjs-externals": "^0.1.4",
    "vite-plugin-vue-devtools": "^8.0.3",
    "vite-plugin-vue-meta-layouts": "^0.5.1",
    "vue": "^3.5.21",
    "vue-eslint-parser": "^10.2.0",
    "vue-router": "^4.5.1",
    "vue-tsc": "^3.0.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@paymoapp/active-window",
      "better-sqlite3",
      "canvas",
      "core-js",
      "electron",
      "esbuild",
      "get-windows",
      "lzma-native",
      "onnxruntime-node",
      "sharp",
      "vue-demi"
    ]
  },
  "packageManager": "pnpm@10.18.1+sha512.77a884a165cbba2d8d1c19e3b4880eee6d2fcabd0d879121e282196b80042351d5eb3ca0935fa599da1dc51265cc68816ad2bddd2a2de5ea9fdf92adbec7cd34"
}
