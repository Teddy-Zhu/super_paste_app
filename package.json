{
  "name": "super-paste",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "dev": "pnpm run prepare:ort && tauri dev",
    "dev:renderer": "vite --host 0.0.0.0",
    "build": "node scripts/build.mjs",
    "build:pacman": "node scripts/build.mjs --bundles pacman",
    "build:renderer": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "prepare:ort": "node scripts/prepare-ort.mjs",
    "release:verify": "node scripts/verify-release-tag.mjs",
    "aur:prepare": "node scripts/prepare-aur.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@vueuse/core": "^13.4.0",
    "dompurify": "^3.2.6",
    "pinia": "^3.0.3",
    "rtf-to-html-converter": "^1.2.4",
    "smooth-scrollbar": "^8.8.4",
    "vue": "^3.5.21",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "^24.9.1",
    "@electron-toolkit/eslint-config-prettier": "3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "^9.36.0",
    "eslint-plugin-vue": "^10.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "^19.3.0",
    "unplugin-icons": "^22.1.0",
    "unplugin-vue-components": "^28.8.0",
    "unplugin-vue-router": "^0.14.0",
    "vite": "^7.3.7",
    "vite-plugin-vue-meta-layouts": "^0.5.1",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.3.13"
  }
}
